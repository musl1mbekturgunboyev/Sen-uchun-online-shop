{
  "name": "sen-uchun",
  "main": "dist/cloudflare/index.js",
  "compatibility_date": "2026-06-01",
  "build": {"command": "node scripts/build.mjs --cloudflare"},
  "assets": {"directory": "public", "binding": "ASSETS"},
  "d1_databases": [{"binding": "DB", "database_name": "sen-uchun", "database_id": "REPLACE_WITH_DATABASE_ID", "migrations_dir": "drizzle"}],
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "sen-uchun-files"}]
}
